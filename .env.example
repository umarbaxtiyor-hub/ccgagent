# Telegram bot token from @BotFather
BOT_TOKEN=

# Gemini API key (aistudio.google.com) for parsing expenses/receipts/bank statements
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Stronger model used specifically for receipt/photo parsing (multi-row
# tables in images need more careful reasoning than plain text does).
GEMINI_VISION_MODEL=gemini-2.5-flash

# OpenAI API key (platform.openai.com), optional. If set, used as an automatic
# fallback whenever Gemini fails (quota exceeded, rate limit, outage, etc.) -
# so the bot keeps working even when one provider is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq API key for voice message transcription (Whisper). Leave empty to disable voice support.
GROQ_API_KEY=

# Postgres connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ccgagent

# Comma-separated Telegram user IDs allowed to use the bot (leave empty to allow everyone - not recommended)
ALLOWED_USER_IDS=

# Comma-separated Telegram user IDs allowed to run admin commands: creating
# projects, assigning employees to a project (/loyiha_yarat, /loyiha_biriktir).
# Leave empty to disable admin commands for everyone.
ADMIN_USER_IDS=

# Google Sheets sync (optional). See docs/google_sheets_webapp.gs for setup -
# leave both empty to disable syncing confirmed transactions to a Sheet.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Telegram numeric user ID to auto-receive a consolidated plain-text daily
# report every day at 21:00 Tashkent time, covering that day's confirmed
# transactions across all employees/projects (optional). Get your own ID
# by messaging the bot with /mening_id. Leave empty to disable.
REPORT_RECIPIENT_ID=
