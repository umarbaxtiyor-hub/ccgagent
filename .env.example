# Telegram bot token from @BotFather
BOT_TOKEN=

# Gemini API key (aistudio.google.com) for parsing expenses/receipts/bank statements
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Stronger model used specifically for receipt/photo parsing (multi-row
# tables in images need more careful reasoning than plain text does).
GEMINI_VISION_MODEL=gemini-2.5-flash

# OpenAI API key (platform.openai.com), optional. If set, used as an automatic
# fallback whenever Gemini fails (quota exceeded, rate limit, outage, etc.) -
# so the bot keeps working even when one provider is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Groq API key for voice message transcription (Whisper). Leave empty to disable voice support.
GROQ_API_KEY=

# Postgres connection (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ccgagent

# Optional legacy/manual allowlist (comma-separated Telegram user IDs).
# Normally not needed: new users request access via /start and an admin
# approves them with a button in the bot itself (see ADMIN_USER_IDS below) -
# no redeploy needed for each new employee. Leave this empty and rely on
# that instead; only set it if you specifically want some IDs hard-allowed
# regardless of DB approval state.
ALLOWED_USER_IDS=

# Comma-separated Telegram user IDs allowed to run admin commands: creating
# projects, assigning employees to a project (/loyiha_yarat, /loyiha_biriktir).
# Leave empty to disable admin commands for everyone.
ADMIN_USER_IDS=

# Google Sheets sync (optional). See docs/google_sheets_webapp.gs for setup -
# leave both empty to disable syncing confirmed transactions to a Sheet.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Telegram numeric user ID OR group chat ID to auto-receive a daily report
# every day at DIGEST_HOUR:DIGEST_MINUTE Tashkent time (one message per
# project + a final summary), covering that day's confirmed transactions
# across all employees/projects (optional). Get a personal ID with
# /mening_id, or a group's ID by adding the bot to the group and running
# /guruh_id there. Leave empty to disable.
REPORT_RECIPIENT_ID=

# When the daily digest above fires, Tashkent time, 24h format (optional,
# default 19:00). Change these to test the digest sooner without waiting
# for the real time - e.g. set to a few minutes from now, confirm it
# arrives, then change back to your real schedule (e.g. 19:00).
DIGEST_HOUR=19
DIGEST_MINUTE=0
